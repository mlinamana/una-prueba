```css
/* ================================= */
/* RESET */
/* ================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Poppins', sans-serif;
    background: #0d0d12;
    color: #ffffff;
}


/* ================================= */
/* HEADER */
/* ================================= */

header {
    background: linear-gradient(135deg, #111116, #1b1b24);
    color: white;

    display: flex;
    justify-content: space-between;
    align-items: center;

    flex-wrap: wrap;
    gap: 20px;

    padding: 20px 40px;

    border-bottom: 2px solid #ff1744;

    box-shadow: 0 5px 20px rgba(0, 0, 0, .5);
}


/* ================================= */
/* LOGO */
/* ================================= */

.logo {
    display: flex;
    align-items: center;
    gap: 15px;
}

.logo-icon {
    width: 65px;
    height: 65px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 32px;

    background: #ff1744;

    border-radius: 15px;

    box-shadow: 0 0 20px rgba(255, 23, 68, .5);
}

.logo h1 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 2px;
}

.logo p {
    color: #aaaaaa;
    font-size: .9rem;
}


/* ================================= */
/* BUSCADOR */
/* ================================= */

.search {
    display: flex;
    gap: 10px;
}

.search input {
    width: 280px;

    padding: 13px 15px;

    border: 1px solid #333;

    border-radius: 8px;

    background: #22222a;

    color: white;

    font-size: 15px;

    outline: none;

    transition: .3s;
}

.search input:focus {
    border-color: #ff1744;

    box-shadow: 0 0 10px rgba(255, 23, 68, .3);
}

.search input::placeholder {
    color: #888;
}

.search button {
    border: none;

    padding: 12px 20px;

    border-radius: 8px;

    background: #ff1744;

    color: white;

    font-weight: 600;

    cursor: pointer;

    transition: .3s;
}

.search button:hover {
    background: #d50032;

    transform: translateY(-2px);
}


/* ================================= */
/* MAIN */
/* ================================= */

main {
    display: grid;

    grid-template-columns: 2fr 1fr;

    gap: 25px;

    padding: 30px;

    max-width: 1500px;

    margin: auto;
}


/* ================================= */
/* TITULO */
/* ================================= */

.section-title {
    display: flex;

    justify-content: space-between;
    align-items: center;

    margin-bottom: 20px;
}

.section-title h2 {
    font-size: 1.7rem;
}

.subtitle {
    color: #888;
    font-size: .9rem;
}

#playerCounter {
    font-weight: bold;

    color: #ff1744;

    background: #1d1115;

    padding: 8px 15px;

    border-radius: 20px;
}


/* ================================= */
/* FILTROS */
/* ================================= */

.filters {
    display: flex;

    gap: 10px;

    margin-bottom: 20px;

    flex-wrap: wrap;
}

.filter {
    border: 1px solid #333;

    background: #19191f;

    color: #bbb;

    padding: 9px 18px;

    border-radius: 20px;

    cursor: pointer;

    transition: .3s;
}

.filter:hover {
    border-color: #ff1744;
    color: white;
}

.filter.active {
    background: #ff1744;
    color: white;

    border-color: #ff1744;
}


/* ================================= */
/* GRID */
/* ================================= */

#forzakenContainer {
    display: grid;

    grid-template-columns:
        repeat(auto-fit, minmax(220px, 1fr));

    gap: 20px;
}


/* ================================= */
/* TARJETAS */
/* ================================= */

.card {
    background: #17171d;

    border: 1px solid #292932;

    border-radius: 15px;

    overflow: hidden;

    box-shadow: 0 8px 20px rgba(0, 0, 0, .4);

    transition: .3s;

    cursor: pointer;
}

.card:hover {
    transform: translateY(-8px);

    border-color: #ff1744;

    box-shadow:
        0 15px 30px rgba(0, 0, 0, .5),
        0 0 15px rgba(255, 23, 68, .15);
}

.card-image {
    width: 100%;

    height: 190px;

    object-fit: cover;

    background: #222;

    display: block;
}

.card-body {
    padding: 18px;
}

.card-body h3 {
    margin: 7px 0;

    font-size: 1.2rem;
}

.id {
    color: #777;

    font-size: .8rem;

    text-transform: uppercase;
}

.description {
    color: #999;

    font-size: .85rem;

    margin-top: 8px;

    line-height: 1.5;
}


/* ================================= */
/* ETIQUETAS */
/* ================================= */

.tipo {
    display: inline-block;

    margin-top: 10px;

    padding: 5px 13px;

    border-radius: 20px;

    font-size: .75rem;

    font-weight: 600;
}

.tipo.player {
    background: #1769aa;
}

.tipo.killer {
    background: #b00020;
}


/* ================================= */
/* BOTON TARJETA */
/* ================================= */

.card button {
    margin-top: 15px;

    width: 100%;

    border: none;

    padding: 11px;

    background: #25252d;

    color: white;

    border-radius: 7px;

    cursor: pointer;

    transition: .3s;
}

.card button:hover {
    background: #ff1744;
}


/* ================================= */
/* PANEL DETALLE */
/* ================================= */

.player-detail {
    background: #17171d;

    border: 1px solid #292932;

    border-radius: 15px;

    padding: 25px;

    box-shadow: 0 8px 20px rgba(0, 0, 0, .4);

    position: sticky;

    top: 20px;

    height: fit-content;

    min-height: 400px;
}

#detailContainer {
    display: flex;

    flex-direction: column;

    gap: 15px;

    text-align: center;
}

#detailContainer img {
    width: 230px;

    height: 230px;

    object-fit: cover;

    border-radius: 12px;

    margin: auto;

    border: 2px solid #333;
}

#detailContainer h2 {
    font-size: 1.8rem;
}

#detailContainer h3 {
    color: #888;
}

#detailContainer p {
    color: #aaa;

    line-height: 1.6;
}

.detail-type {
    margin: auto;
}


/* ================================= */
/* WELCOME */
/* ================================= */

.welcome-icon {
    width: 90px;
    height: 90px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin: 30px auto 10px;

    font-size: 45px;

    background: #ff1744;

    border-radius: 20px;

    box-shadow: 0 0 25px rgba(255, 23, 68, .3);
}

.welcome-box {
    display: flex;

    justify-content: center;

    gap: 12px;

    margin-top: 20px;

    padding: 15px;

    background: #222229;

    border-radius: 10px;

    color: #aaa;
}


/* ================================= */
/* ESTADISTICAS */
/* ================================= */

.stats {
    margin-top: 15px;

    text-align: left;
}

.stat {
    margin-bottom: 15px;
}

.stat-header {
    display: flex;

    justify-content: space-between;

    margin-bottom: 5px;

    font-size: .85rem;
}

.progress {
    width: 100%;

    height: 10px;

    background: #303038;

    border-radius: 20px;

    overflow: hidden;
}

.progress span {
    display: block;

    height: 100%;

    background: linear-gradient(
        90deg,
        #ff1744,
        #ff5252
    );

    border-radius: 20px;
}


/* ================================= */
/* HABILIDADES */
/* ================================= */

.abilities {
    text-align: left;

    background: #202027;

    padding: 15px;

    border-radius: 10px;
}

.abilities h3 {
    margin-bottom: 10px;
}

.abilities ul {
    list-style: none;
}

.abilities li {
    padding: 5px 0;

    color: #bbb;
}

.abilities li::before {
    content: "⚡ ";

    color: #ff1744;
}


/* ================================= */
/* PAGINACION */
/* ================================= */

.pagination {
    display: flex;

    justify-content: center;

    gap: 20px;

    margin-top: 30px;
}

.pagination button {
    border: 1px solid #333;

    padding: 12px 20px;

    border-radius: 8px;

    cursor: pointer;

    background: #19191f;

    color: white;

    transition: .3s;
}

.pagination button:hover:not(:disabled) {
    background: #ff1744;

    border-color: #ff1744;
}

.pagination button:disabled {
    opacity: .3;

    cursor: not-allowed;
}


/* ================================= */
/* LOADING */
/* ================================= */

#loading {
    position: fixed;

    inset: 0;

    background: rgba(5, 5, 8, .95);

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: center;

    gap: 20px;

    z-index: 999;
}

.hidden {
    display: none !important;
}

.loader {
    width: 65px;

    height: 65px;

    border-radius: 50%;

    border: 7px solid #333;

    border-top: 7px solid #ff1744;

    animation: spin 1s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}


/* ================================= */
/* ERROR */
/* ================================= */

#errorMessage {
    position: fixed;

    bottom: 25px;

    right: 25px;

    background: #b00020;

    color: white;

    padding: 15px 20px;

    border-radius: 10px;

    box-shadow: 0 8px 15px rgba(0, 0, 0, .5);

    z-index: 1000;
}


/* ================================= */
/* FOOTER */
/* ================================= */

footer {
    margin-top: 30px;

    background: #09090c;

    border-top: 1px solid #292932;

    color: white;

    text-align: center;

    padding: 25px;
}

footer h3 {
    color: #ff1744;

    margin-bottom: 5px;
}

footer p {
    color: #888;
}

.footer-small {
    font-size: .8rem;

    margin-top: 5px;
}


/* ================================= */
/* RESPONSIVE */
/* ================================= */

@media(max-width: 992px) {

    main {
        grid-template-columns: 1fr;
    }

    .player-detail {
        position: relative;

        top: 0;
    }

}


@media(max-width: 768px) {

    header {
        flex-direction: column;

        text-align: center;
    }

    .search {
        width: 100%;
    }

    .search input {
        width: 100%;
    }

    .search button {
        width: 120px;
    }

}


@media(max-width: 480px) {

    main {
        padding: 15px;
    }

    #forzakenContainer {
        grid-template-columns: 1fr;
    }

    .logo h1 {
        font-size: 1.5rem;
    }

    .logo-icon {
        width: 55px;
        height: 55px;

        font-size: 25px;
    }

    .section-title {
        align-items: flex-start;

        gap: 10px;
    }

    .section-title h2 {
        font-size: 1.3rem;
    }

    .search {
        flex-direction: column;
    }

    .search button {
        width: 100%;
    }

}
